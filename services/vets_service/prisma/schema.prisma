// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Treatment {
  id          Int    @id @default(autoincrement())
  icon        String
  title       String
  description String
  duration    String // e.g. "15 min"

  @@map("treatments")
}

model Vet {
  id       Int    @id @default(autoincrement())
  name     String
  role     String
  bio      String
  initials String

  @@map("vets")
}

model AppointmentType {
  id              Int    @id @default(autoincrement())
  slug            String @unique // e.g. "vaccination"
  label           String
  durationMinutes Int    @map("duration_minutes")

  @@map("appointment_types")
}

// A client of the practice. The email is the link to the login in
// auth-service: a logged-in user sees the owner with the same email.
model Owner {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String
  pets  Pet[]

  @@map("owners")
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   String // e.g. "Cat"
  breed     String
  birthDate DateTime @map("birth_date")
  ownerId   Int      @map("owner_id")
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("pets")
}
