# Copy this file to .env: cp .env.example .env

# URL of the API gateway, used on the server (+page.server.ts).
# The gateway forwards /vets, /treatments and /appointment-types to the vets service.
VET_SERVICE_API_URL=http://localhost:3000

# Same URL, but readable in the browser (components that fetch themselves).
# Only variables starting with PUBLIC_ are sent to the browser.
PUBLIC_VET_SERVICE_API_URL=http://localhost:3000
